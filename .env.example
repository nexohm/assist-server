# Creato da install.sh. Modificalo e poi: ./ha-suite riavvia

# Dominio pubblico del server di assistenza (deve puntare all'IP pubblico di questa macchina)
DOMAIN=assistenza.example.it

# "https" = Caddy con certificato automatico; vuoto = hai già un tuo reverse proxy
COMPOSE_PROFILES=https

# Con un proxy esterno su un'altra macchina: SUITE_BIND=0.0.0.0
SUITE_BIND=127.0.0.1
SUITE_PORT=8080

# Versione: "latest" segue gli aggiornamenti, oppure fissa una versione (es. 0.2.0)
SUITE_TAG=latest
SUITE_IMAGE=ghcr.io/nexohm/assist-server
