#!/usr/bin/env bash
# Comandi di gestione del server di assistenza. Uso: ./ha-suite <comando>
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

# La configurazione (.env) è leggibile solo da root: se serve, si rilancia con sudo.
if [[ $EUID -ne 0 ]] && { [[ -f .env && ! -r .env ]] || ! docker info >/dev/null 2>&1; }; then
  exec sudo "$(readlink -f "$0")" "$@"
fi

dc() { docker compose "$@"; }

# Da dove scaricare gli aggiornamenti dei file di gestione (impostato da install.sh nel .env)
REPO_RAW="https://raw.githubusercontent.com/nexohm/assist-server/main"
if [[ -r .env ]] && grep -q '^SUITE_REPO_RAW=' .env; then
  REPO_RAW=$(grep '^SUITE_REPO_RAW=' .env | cut -d= -f2-)
fi

# Aggiorna questo script, docker-compose.yml e Caddyfile. Se lo script è cambiato,
# rilancia la versione nuova (una sola volta) così l'aggiornamento usa sempre l'ultima logica.
self_update() {
  local tmp; tmp=$(mktemp -d)
  for f in ha-suite docker-compose.yml Caddyfile; do
    if ! curl -fsSL "$REPO_RAW/$f" -o "$tmp/$f" || [[ ! -s "$tmp/$f" ]]; then
      echo "  Attenzione: impossibile scaricare $f, tengo quello attuale."
      rm -f "$tmp/$f"
    fi
  done
  [[ -f "$tmp/ha-suite" ]] && ! bash -n "$tmp/ha-suite" 2>/dev/null && rm -f "$tmp/ha-suite"
  for f in docker-compose.yml Caddyfile; do
    if [[ -f "$tmp/$f" ]] && ! cmp -s "$tmp/$f" "$f"; then
      cp -f "$f" "$f.bak" 2>/dev/null || true
      mv -f "$tmp/$f" "$f"
      echo "  $f aggiornato (copia precedente: $f.bak)"
    fi
  done
  if [[ -f "$tmp/ha-suite" ]] && ! cmp -s "$tmp/ha-suite" ha-suite; then
    install -m 755 "$tmp/ha-suite" ha-suite
    rm -rf "$tmp"
    echo "  Script ha-suite aggiornato: riprendo con la versione nuova."
    export HA_SUITE_UPDATED=1
    exec ./ha-suite "$@"
  fi
  rm -rf "$tmp"
}

case "${1:-aiuto}" in
  stato)
    dc ps
    ;;
  log)
    dc logs --tail=200 -f suite
    ;;
  riavvia)
    dc up -d
    ;;
  codice)
    # Codice di installazione per la prima configurazione dal browser
    if code=$(dc exec -T suite cat /data/setup-code.txt 2>/dev/null); then
      echo "Codice di installazione: $code"
    else
      echo "Nessun codice: la configurazione iniziale è già stata fatta."
    fi
    ;;
  versione)
    dc exec -T suite printenv SUITE_VERSION || echo "server non in esecuzione"
    ;;
  aggiorna)
    if [[ -z "${HA_SUITE_UPDATED:-}" ]]; then
      echo "Controllo i file di gestione..."
      self_update "$@"
    fi
    echo "Copia di sicurezza prima dell'aggiornamento..."
    "$0" backup
    dc pull
    dc up -d
    docker image prune -f >/dev/null
    echo "Aggiornato. Versione in esecuzione:"
    dc exec -T suite printenv SUITE_VERSION || true
    ;;
  backup)
    mkdir -p backup
    file="backup/ha-suite-$(date +%Y%m%d-%H%M%S).tar.gz"
    # Fermo un istante il server per avere un database coerente
    dc stop suite >/dev/null
    docker run --rm -v ha-suite_suite_data:/data:ro -v "$PWD/backup:/out" alpine \
      tar czf "/out/$(basename "$file")" -C /data .
    dc start suite >/dev/null
    # tiene solo gli ultimi 14 backup
    find backup -maxdepth 1 -name 'ha-suite-*.tar.gz' -printf '%T@ %p\n' | sort -rn | tail -n +15 | cut -d' ' -f2- | xargs -r rm --
    echo "Backup salvato in $file"
    ;;
  ripristina)
    file="${2:?indica il file: ./ha-suite ripristina backup/ha-suite-....tar.gz}"
    read -rp "Tutti i dati attuali verranno sostituiti con $file. Continuare? [s/N] " ok
    [[ "${ok,,}" == "s" ]] || exit 1
    dc stop suite >/dev/null
    docker run --rm -v ha-suite_suite_data:/data -v "$(readlink -f "$file"):/in.tar.gz:ro" alpine \
      sh -c 'rm -rf /data/* && tar xzf /in.tar.gz -C /data && chown -R 1000:1000 /data'
    dc start suite >/dev/null
    echo "Ripristino completato."
    ;;
  disinstalla)
    read -rp "Rimuovere i container? I dati restano nel volume ha-suite_suite_data. [s/N] " ok
    [[ "${ok,,}" == "s" ]] && dc down
    ;;
  *)
    cat <<'HELP'
Uso: ./ha-suite <comando>

  stato        mostra se il server è in funzione
  log          segue i log del server
  aggiorna     aggiorna anche questo script, backup, scarica l'ultima versione, riavvia
  versione     mostra la versione del server in esecuzione
  backup       salva tutti i dati in ./backup (tiene gli ultimi 14)
  ripristina   ripristina un backup:  ./ha-suite ripristina backup/<file>.tar.gz
  codice       mostra il codice di installazione (solo prima della configurazione iniziale)
  riavvia      applica modifiche al file .env
  disinstalla  rimuove i container (i dati restano)
HELP
    ;;
esac
